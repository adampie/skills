{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>adampie/renovate-config:default.json5",
    "schedule:weekly",
  ],

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/.+/"],
      "matchStrings": [
        "renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(\\s+versioning=(?<versioning>\\S+))?[^\\n]*\\n[^\\n]*?[\\w.\\-]+\\s*[:=]\\s*[\"']?(?<currentValue>[^\"'\\s,)\\]}]+)",
      ],
    },
  ],
}
