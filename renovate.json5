{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>adampie/renovate-config:default.json5",
    "schedule:weekly",
  ],

  // Annotate any pinned version, anywhere in the repo, and Renovate tracks it:
  //
  //   # renovate: datasource=npm depName=prettier
  //   PRETTIER_VERSION: 3.4.2
  //
  // versioning=<scheme> is optional; without it the datasource default applies.
  // Engine is re2, so the pattern uses no lookarounds.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/.+/"],
      "matchStrings": [
        "renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(\\s+versioning=(?<versioning>\\S+))?[^\\n]*\\n[^\\n]*?[\\w.\\-]+\\s*[:=]\\s*[\"']?(?<currentValue>[^\"'\\s,)\\]}]+)",
      ],
    },
  ],
}
